# ---- backend (set on Render / your shell) ----
CORS_ORIGINS=http://localhost:3000
# CORS_ORIGIN_REGEX=https://truthlens-ai-.*\.vercel\.app   # optional: Vercel preview URLs
MAX_TEXT_CHARS=20000
MAX_UPLOAD_BYTES=2097152
MAX_BATCH_ROWS=1000
RATE_LIMIT_PER_MIN=60
TRUST_PROXY=0          # 1 when behind Render/Vercel proxies

# ---- frontend (frontend/.env.local, or Vercel project settings) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
